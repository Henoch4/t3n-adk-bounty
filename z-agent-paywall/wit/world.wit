package z:agent-paywall@0.2.0;

world agent-paywall {
    import host:tenant/tenant-context@1.0.0;
    import host:interfaces/logging@2.1.0;
    import host:interfaces/kv-store@2.1.0;

    export contracts;
}

interface contracts {
    record generic-input {
        input:        option<list<u8>>,
        user-profile: option<list<u8>>,
        context:      option<list<u8>>,
    }

    /// Check whether a priced agent call is under the session budget AND the
    /// per-call cap. Reads spend counters from KV; no side effects.
    /// Input  (JSON): { caller, label, amount_cents }
    /// Output (JSON): { allowed, label, caller_key, session_spent_cents,
    ///                  session_budget_cents, session_remaining_cents, reason }
    check-gate: func(req: generic-input) -> result<list<u8>, string>;

    /// Atomic gate-check + spend: validates the call is within the same
    /// budget+cap policy as check-gate, increments the session counter (KV),
    /// and meters the payment.
    /// Input  (JSON): { caller, label, amount_cents }
    /// Output (JSON): { granted, label, caller_key, spent_cents,
    ///                  session_spent_cents, session_remaining_cents, reason }
    enter-gateway: func(req: generic-input) -> result<list<u8>, string>;

    /// Pay for one service press — same gate, then emit a Stripe
    /// PaymentIntent-style ref.
    /// Input  (JSON): { caller, amount_cents, currency }
    /// Output (JSON): { paid, caller_key, payment_intent, amount_cents,
    ///                  currency, session_remaining_cents, reason }
    pay-for-service: func(req: generic-input) -> result<list<u8>, string>;
}